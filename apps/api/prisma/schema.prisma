generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportType {
  INITIAL_BALANCE
  RECEIPT
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

enum ImportRowStatus {
  VALID
  WARNING
  ERROR
  SKIPPED
  IMPORTED
}

enum StockTransactionType {
  INITIAL_BALANCE
  RECEIPT
  MANUAL_RECEIPT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_OUT
  TRANSFER_IN
  ISSUE
  TRANSFER_REVERSAL_OUT
  TRANSFER_REVERSAL_IN
  ISSUE_REVERSAL
  ASSIGNMENT_OUT_DIRECT
  ASSIGNMENT_OUT_CUSTODY
  ASSIGNMENT_IN_DIRECT
  ASSIGNMENT_IN_CUSTODY
  ISSUE_FROM_DIRECT
  ISSUE_FROM_CUSTODY
  ASSIGNMENT_REVERSAL
  MVO_TRANSFER_OUT
  MVO_TRANSFER_REVERSAL
  ISSUE_OUT
  IMPORT_RECEIPT
}

enum StockDocumentType {
  TRANSFER
  ASSIGNMENT
  MVO_TRANSFER
  ISSUE
}

enum StockSourceKind {
  DIRECT
  ASSIGNED
}

enum StockAccountingModel {
  LEGACY_BALANCE
  OWNER_CUSTODY
  DIRECT_BALANCE
}

enum StockDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum IssueRealizationStatus {
  POSTED
  CANCELLED
}

enum AccountingExportState {
  NOT_EXPORTED
  EXPORTED
}

enum InventoryItemReviewStatus {
  VERIFIED
  NEEDS_REVIEW
}

enum UserRole {
  OWNER
  AUDITOR
  DPP_ADMIN
  MVO
  ACCOUNTANT
  ORG_MANAGER
}

enum PreAuthChallengeStage {
  CHANGE_PASSWORD
  ENROLL_2FA
  VERIFY_2FA
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_CREATED
  USER_UPDATED
  USER_BLOCKED
  USER_UNBLOCKED
  USER_ACTIVATED
  USER_DEACTIVATED
  ROLE_CHANGED
  SESSIONS_REVOKED
  ACCESS_DENIED
  OWNER_DESTRUCTIVE_ACTION
  STOCK_DOCUMENT_ACTION
  IMPORT_ACTION
  TWO_FACTOR_ENABLED
  TWO_FACTOR_VERIFIED
  TWO_FACTOR_RECOVERY_CODE_USED
  TWO_FACTOR_FAILED
  TWO_FACTOR_RESET_BY_OWNER
}

model Management {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  shortName          String?
  code               String               @unique
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  services           Service[]
  responsiblePersons ResponsiblePerson[]
  userAccessScopes   UserAccessScope[]

  @@index([isActive])
}

model Service {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  code               String
  managementId       String              @db.Uuid
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  management         Management          @relation(fields: [managementId], references: [id], onDelete: Restrict)
  units              Unit[]
  responsiblePersons ResponsiblePerson[]

  @@unique([managementId, code])
  @@index([managementId])
  @@index([isActive])
}

model Unit {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  code               String
  serviceId          String              @db.Uuid
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  service            Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  responsiblePersons ResponsiblePerson[]

  @@unique([serviceId, code])
  @@index([serviceId])
  @@index([isActive])
}

model ResponsiblePerson {
  id                     String             @id @default(uuid()) @db.Uuid
  lastName               String
  firstName              String
  middleName             String?
  personnelNumber        String             @unique
  position               String?
  phone                  String?
  email                  String?
  externalAccountingName String?            @unique
  externalAccountingCode String?            @unique
  managementId           String             @db.Uuid
  serviceId              String             @db.Uuid
  unitId                 String?            @db.Uuid
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  management             Management         @relation(fields: [managementId], references: [id], onDelete: Restrict)
  service                Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  unit                   Unit?              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  stockBalances          StockBalance[]
  stockTransactions      StockTransaction[]
  importRows             ImportRow[]
  user                   User?
  sourceStockDocuments   StockDocument[]    @relation("StockDocumentSource")
  destinationStockDocuments StockDocument[] @relation("StockDocumentDestination")
  accountingOwnedCustodyBalances CustodyBalance[] @relation("CustodyBalanceAccountingOwner")
  custodialBalances              CustodyBalance[] @relation("CustodyBalanceCustodian")
  accountingOwnedDocumentLines   StockDocumentLine[] @relation("StockDocumentLineAccountingOwner")
  sourceCustodianDocumentLines   StockDocumentLine[] @relation("StockDocumentLineSourceCustodian")
  accountingOwnedTransactions    StockTransaction[] @relation("StockTransactionAccountingOwner")
  sourceCustodianTransactions    StockTransaction[] @relation("StockTransactionSourceCustodian")
  destinationCustodianTransactions StockTransaction[] @relation("StockTransactionDestinationCustodian")

  @@index([managementId])
  @@index([serviceId])
  @@index([unitId])
  @@index([isActive])
  @@index([lastName])
  @@index([firstName])
  @@index([middleName])
  @@index([personnelNumber])
}

model User {
  id                   String             @id @default(uuid()) @db.Uuid
  username             String             @unique
  passwordHash         String
  role                 UserRole
  isActive             Boolean            @default(true)
  mustChangePassword   Boolean            @default(true)
  failedLoginAttempts  Int                @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  twoFactorEnabled     Boolean            @default(false)
  twoFactorSecretEncrypted String?
  twoFactorConfirmedAt DateTime?
  responsiblePersonId  String?            @unique @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdById          String?            @db.Uuid
  responsiblePerson    ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  createdBy            User?              @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers         User[]             @relation("UserCreatedBy")
  sessions             UserSession[]
  preAuthChallenges    PreAuthChallenge[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  actorSecurityEvents  SecurityEvent[]    @relation("SecurityEventActor")
  targetSecurityEvents SecurityEvent[]    @relation("SecurityEventTarget")
  createdStockDocuments   StockDocument[]  @relation("StockDocumentCreatedBy")
  postedStockDocuments    StockDocument[]  @relation("StockDocumentPostedBy")
  cancelledStockDocuments StockDocument[]  @relation("StockDocumentCancelledBy")
  exportedStockDocuments  StockDocument[]  @relation("StockDocumentExportedBy")
  uploadedStockDocumentAttachments StockDocumentAttachment[]
  createdIssueRealizations          IssueRealization[]           @relation("IssueRealizationCreatedBy")
  cancelledIssueRealizations        IssueRealization[]           @relation("IssueRealizationCancelledBy")
  uploadedIssueRealizationAttachments IssueRealizationAttachment[]
  accountingTransferExportBatches AccountingTransferExportBatch[]
  accessScopes                    UserAccessScope[]

  @@index([role])
  @@index([isActive])
  @@index([createdById])
  @@index([responsiblePersonId])
}

model UserAccessScope {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  managementId String?     @db.Uuid
  serviceCode  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  management   Management? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([managementId])
  @@index([serviceCode])
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PreAuthChallenge {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  tokenHash      String                @unique
  stage          PreAuthChallengeStage
  expiresAt      DateTime
  failedAttempts Int                   @default(0)
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityEvent {
  id           String            @id @default(uuid()) @db.Uuid
  type         SecurityEventType
  actorUserId  String?           @db.Uuid
  targetUserId String?           @db.Uuid
  ipAddress    String?
  userAgent    String?
  requestId    String?
  metadata     Json?
  success      Boolean
  createdAt    DateTime          @default(now())
  actorUser    User?             @relation("SecurityEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?             @relation("SecurityEventTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@index([success])
}

model InventoryItem {
  id                String                    @id @default(uuid()) @db.Uuid
  externalCode      String                    @unique
  name              String
  unitOfMeasure     String?
  category          String?
  description       String?
  reviewStatus      InventoryItemReviewStatus @default(NEEDS_REVIEW)
  isActive          Boolean                   @default(true)
  createdManually   Boolean                   @default(false)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  stockBalances     StockBalance[]
  stockTransactions StockTransaction[]
  importRows        ImportRow[]
  stockDocumentLines StockDocumentLine[]
  custodyBalances    CustodyBalance[]

  @@index([name])
  @@index([reviewStatus])
  @@index([isActive])
}

model StockBalance {
  id                  String            @id @default(uuid()) @db.Uuid
  responsiblePersonId String            @db.Uuid
  inventoryItemId     String            @db.Uuid
  quantity            Decimal           @default(0) @db.Decimal(18, 4)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  responsiblePerson   ResponsiblePerson @relation(fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  inventoryItem       InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  sourceDocumentLines StockDocumentLine[] @relation("StockDocumentLineSourceBalance")

  @@unique([responsiblePersonId, inventoryItemId])
  @@index([responsiblePersonId])
  @@index([inventoryItemId])
}

model CustodyBalance {
  id                                    String            @id @default(uuid()) @db.Uuid
  inventoryItemId                       String            @db.Uuid
  accountingOwnerResponsiblePersonId    String            @db.Uuid
  custodianResponsiblePersonId           String            @db.Uuid
  quantity                              Decimal           @default(0) @db.Decimal(18, 4)
  createdAt                             DateTime          @default(now())
  updatedAt                             DateTime          @updatedAt
  inventoryItem                         InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  accountingOwnerResponsiblePerson      ResponsiblePerson @relation("CustodyBalanceAccountingOwner", fields: [accountingOwnerResponsiblePersonId], references: [id], onDelete: Restrict)
  custodianResponsiblePerson             ResponsiblePerson @relation("CustodyBalanceCustodian", fields: [custodianResponsiblePersonId], references: [id], onDelete: Restrict)
  sourceDocumentLines                    StockDocumentLine[]

  @@unique([inventoryItemId, accountingOwnerResponsiblePersonId, custodianResponsiblePersonId])
  @@index([inventoryItemId])
  @@index([accountingOwnerResponsiblePersonId])
  @@index([custodianResponsiblePersonId])
  @@index([accountingOwnerResponsiblePersonId, inventoryItemId])
  @@index([custodianResponsiblePersonId, inventoryItemId])
}

model StockTransaction {
  id                  String               @id @default(uuid()) @db.Uuid
  type                StockTransactionType
  responsiblePersonId String               @db.Uuid
  inventoryItemId     String               @db.Uuid
  quantity            Decimal              @db.Decimal(18, 4)
  balanceBefore       Decimal              @db.Decimal(18, 4)
  balanceAfter        Decimal              @db.Decimal(18, 4)
  occurredAt          DateTime
  comment             String?
  sourceDocument      String?
  importBatchId       String?              @db.Uuid
  importRowId         String?              @unique @db.Uuid
  documentId          String?              @db.Uuid
  documentLineId      String?              @db.Uuid
  accountingModel     StockAccountingModel?
  bucketKind          StockSourceKind?
  accountingOwnerResponsiblePersonId String? @db.Uuid
  sourceCustodianResponsiblePersonId String? @db.Uuid
  destinationCustodianResponsiblePersonId String? @db.Uuid
  reversalOfTransactionId String?          @unique @db.Uuid
  createdAt           DateTime             @default(now())
  responsiblePerson   ResponsiblePerson    @relation(fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  inventoryItem       InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  importBatch         ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  importRow           ImportRow?           @relation(fields: [importRowId], references: [id], onDelete: Restrict)
  document            StockDocument?       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentLine        StockDocumentLine?   @relation(fields: [documentLineId], references: [id], onDelete: Restrict)
  accountingOwnerResponsiblePerson ResponsiblePerson? @relation("StockTransactionAccountingOwner", fields: [accountingOwnerResponsiblePersonId], references: [id], onDelete: Restrict)
  sourceCustodianResponsiblePerson ResponsiblePerson? @relation("StockTransactionSourceCustodian", fields: [sourceCustodianResponsiblePersonId], references: [id], onDelete: Restrict)
  destinationCustodianResponsiblePerson ResponsiblePerson? @relation("StockTransactionDestinationCustodian", fields: [destinationCustodianResponsiblePersonId], references: [id], onDelete: Restrict)
  reversalOfTransaction StockTransaction? @relation("StockTransactionReversal", fields: [reversalOfTransactionId], references: [id], onDelete: Restrict)
  reversedByTransaction StockTransaction? @relation("StockTransactionReversal")

  @@index([responsiblePersonId])
  @@index([inventoryItemId])
  @@index([type])
  @@index([occurredAt])
  @@index([importBatchId])
  @@index([documentId])
  @@index([documentLineId])
  @@index([accountingOwnerResponsiblePersonId])
  @@index([sourceCustodianResponsiblePersonId])
  @@index([destinationCustodianResponsiblePersonId])
  @@index([accountingModel])
  @@index([bucketKind])
}

model StockDocument {
  id                             String              @id @default(uuid()) @db.Uuid
  documentNumber                 String              @unique
  displayNumber                  Int                 @unique @default(autoincrement())
  documentDate                   DateTime
  type                           StockDocumentType
  accountingModel                StockAccountingModel?
  status                         StockDocumentStatus @default(DRAFT)
  accountingExportState          AccountingExportState @default(NOT_EXPORTED)
  sourceResponsiblePersonId      String              @db.Uuid
  destinationResponsiblePersonId String?             @db.Uuid
  recipientName                  String?
  recipientUnit                  String?
  basis                          String?
  note                           String?
  createdByUserId                String?             @db.Uuid
  postedByUserId                 String?             @db.Uuid
  postedAt                       DateTime?
  cancelledByUserId              String?             @db.Uuid
  cancelledAt                    DateTime?
  exportedByUserId               String?             @db.Uuid
  exportedAt                     DateTime?
  sourceTransferId               String?             @db.Uuid
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
  sourceResponsiblePerson        ResponsiblePerson   @relation("StockDocumentSource", fields: [sourceResponsiblePersonId], references: [id], onDelete: Restrict)
  destinationResponsiblePerson   ResponsiblePerson?  @relation("StockDocumentDestination", fields: [destinationResponsiblePersonId], references: [id], onDelete: Restrict)
  createdByUser                  User?               @relation("StockDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  postedByUser                   User?               @relation("StockDocumentPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  cancelledByUser                User?               @relation("StockDocumentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  exportedByUser                 User?               @relation("StockDocumentExportedBy", fields: [exportedByUserId], references: [id], onDelete: Restrict)
  lines                          StockDocumentLine[]
  transactions                   StockTransaction[]
  attachments                    StockDocumentAttachment[]
  accountingExportBatches        AccountingTransferExportBatchDocument[]
  sourceTransfer                 StockDocument?       @relation("TransferIssues", fields: [sourceTransferId], references: [id], onDelete: Restrict)
  issues                         StockDocument[]       @relation("TransferIssues")
  issueRealizations              IssueRealization[]

  @@index([type])
  @@index([status])
  @@index([documentDate])
  @@index([sourceResponsiblePersonId])
  @@index([destinationResponsiblePersonId])
  @@index([createdByUserId])
  @@index([accountingModel])
  @@index([accountingExportState])
  @@index([exportedByUserId])
  @@index([exportedAt])
  @@index([sourceTransferId])
}

model StockDocumentLine {
  id              String             @id @default(uuid()) @db.Uuid
  documentId      String             @db.Uuid
  inventoryItemId String             @db.Uuid
  sourceKind      StockSourceKind?
  accountingOwnerResponsiblePersonId String? @db.Uuid
  sourceCustodianResponsiblePersonId String? @db.Uuid
  sourceCustodyBalanceId String?      @db.Uuid
  sourceBalanceId String?             @db.Uuid
  sourceTransferLineId String?         @db.Uuid
  quantityBefore Decimal?             @db.Decimal(18, 4)
  quantityAfter  Decimal?             @db.Decimal(18, 4)
  quantity        Decimal            @db.Decimal(18, 4)
  note            String?
  createdAt       DateTime           @default(now())
  document        StockDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  accountingOwnerResponsiblePerson ResponsiblePerson? @relation("StockDocumentLineAccountingOwner", fields: [accountingOwnerResponsiblePersonId], references: [id], onDelete: Restrict)
  sourceCustodianResponsiblePerson ResponsiblePerson? @relation("StockDocumentLineSourceCustodian", fields: [sourceCustodianResponsiblePersonId], references: [id], onDelete: Restrict)
  sourceCustodyBalance CustodyBalance? @relation(fields: [sourceCustodyBalanceId], references: [id], onDelete: Restrict)
  sourceBalance StockBalance?          @relation("StockDocumentLineSourceBalance", fields: [sourceBalanceId], references: [id], onDelete: Restrict)
  sourceTransferLine StockDocumentLine? @relation("TransferIssueLines", fields: [sourceTransferLineId], references: [id], onDelete: Restrict)
  issueLines       StockDocumentLine[]  @relation("TransferIssueLines")
  realizationLines IssueRealizationLine[]
  transactions    StockTransaction[]

  @@index([documentId])
  @@index([inventoryItemId])
  @@index([accountingOwnerResponsiblePersonId])
  @@index([sourceCustodianResponsiblePersonId])
  @@index([sourceCustodyBalanceId])
  @@index([sourceBalanceId])
  @@index([sourceTransferLineId])
}

model StockDocumentAttachment {
  id               String        @id @default(uuid()) @db.Uuid
  documentId       String        @db.Uuid
  originalFileName String
  storedFileName   String        @unique
  mimeType         String
  sizeBytes        Int
  sha256           String
  storagePath      String
  uploadedByUserId String?       @db.Uuid
  createdAt        DateTime      @default(now())
  document         StockDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedByUser   User?         @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([uploadedByUserId])
  @@index([sha256])
}

model IssueRealization {
  id                String                 @id @default(uuid()) @db.Uuid
  issueId           String                 @db.Uuid
  displayNumber     Int                    @unique @default(autoincrement())
  realizationDate   DateTime
  recipientText     String?
  note              String?
  status            IssueRealizationStatus @default(POSTED)
  createdByUserId   String?                @db.Uuid
  cancelledByUserId String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  cancelledAt       DateTime?
  issue             StockDocument          @relation(fields: [issueId], references: [id], onDelete: Restrict)
  createdByUser     User?                  @relation("IssueRealizationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledByUser   User?                  @relation("IssueRealizationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  lines             IssueRealizationLine[]
  attachments       IssueRealizationAttachment[]

  @@index([issueId])
  @@index([status])
  @@index([realizationDate])
  @@index([createdByUserId])
  @@index([cancelledByUserId])
}

model IssueRealizationLine {
  id             String           @id @default(uuid()) @db.Uuid
  realizationId  String           @db.Uuid
  issueLineId    String           @db.Uuid
  quantity       Decimal          @db.Decimal(18, 4)
  createdAt      DateTime         @default(now())
  realization    IssueRealization @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  issueLine      StockDocumentLine @relation(fields: [issueLineId], references: [id], onDelete: Restrict)

  @@unique([realizationId, issueLineId])
  @@index([realizationId])
  @@index([issueLineId])
}

model IssueRealizationAttachment {
  id               String           @id @default(uuid()) @db.Uuid
  realizationId    String           @db.Uuid
  originalFileName String
  storedFileName   String           @unique
  mimeType         String
  sizeBytes        Int
  sha256           String
  storagePath      String
  uploadedByUserId String?          @db.Uuid
  createdAt        DateTime         @default(now())
  realization      IssueRealization @relation(fields: [realizationId], references: [id], onDelete: Restrict)
  uploadedByUser   User?            @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([realizationId])
  @@index([uploadedByUserId])
  @@index([sha256])
}

model AccountingTransferExportBatch {
  id              String    @id @default(uuid()) @db.Uuid
  createdByUserId String?   @db.Uuid
  filters         Json
  filename        String
  sha256          String
  formatVersion   Int       @default(2)
  documentCount   Int
  rowCount        Int
  createdAt       DateTime  @default(now())
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents       AccountingTransferExportBatchDocument[]
  rows            AccountingTransferExportRow[]

  @@index([createdByUserId])
  @@index([createdAt])
}

model AccountingTransferExportBatchDocument {
  batchId    String   @db.Uuid
  documentId String   @db.Uuid
  batch      AccountingTransferExportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  document   StockDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([batchId, documentId])
  @@index([documentId])
}

model AccountingTransferExportRow {
  id                         String              @id @default(uuid()) @db.Uuid
  batchId                    String              @db.Uuid
  documentId                 String              @db.Uuid
  documentLineId             String              @db.Uuid
  documentNumber             String
  displayNumber              Int?
  documentDate               DateTime
  sourcePersonnelNumber      String
  sourceFullName             String
  sourceManagementName       String
  destinationPersonnelNumber String
  destinationFullName        String
  destinationManagementName  String
  inventoryCode              String
  inventoryName              String
  unitOfMeasure              String?
  quantity                   Decimal             @db.Decimal(18, 4)
  documentStatus             StockDocumentStatus
  postedAt                   DateTime?
  rowOrder                   Int
  batch                      AccountingTransferExportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowOrder])
  @@index([batchId])
  @@index([documentId])
}

model ImportBatch {
  id               String             @id @default(uuid()) @db.Uuid
  type             ImportType
  status           ImportStatus       @default(UPLOADED)
  originalFilename String
  fileHash         String             @unique
  fileSize         Int
  encoding         String
  delimiter        String
  totalRows        Int                @default(0)
  validRows        Int                @default(0)
  warningRows      Int                @default(0)
  errorRows        Int                @default(0)
  skippedRows      Int                @default(0)
  importedRows     Int                @default(0)
  periodStart      DateTime?
  periodEnd        DateTime?
  createdAt        DateTime           @default(now())
  validatedAt      DateTime?
  completedAt      DateTime?
  rows             ImportRow[]
  transactions     StockTransaction[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model ImportRow {
  id                  String             @id @default(uuid()) @db.Uuid
  importBatchId       String             @db.Uuid
  rowNumber           Int
  status              ImportRowStatus
  counterpartyRaw     String
  nomenclatureCodeRaw String
  itemNameRaw         String
  unitOfMeasureRaw    String?
  debitQuantityRaw    String?
  endingQuantityRaw   String?
  parsedQuantity      Decimal?           @db.Decimal(18, 4)
  responsiblePersonId String?            @db.Uuid
  inventoryItemId     String?            @db.Uuid
  message             String?
  systemBalance       Decimal?           @db.Decimal(18, 4)
  fileEndingBalance   Decimal?           @db.Decimal(18, 4)
  balanceDifference   Decimal?           @db.Decimal(18, 4)
  createdAt           DateTime           @default(now())
  importBatch         ImportBatch        @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  responsiblePerson   ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  inventoryItem       InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockTransaction    StockTransaction?

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId])
  @@index([status])
  @@index([responsiblePersonId])
  @@index([inventoryItemId])
}
